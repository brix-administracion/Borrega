# Cache del sitio estatico (Astro) servido en Hostinger.
# HTML: se revalida siempre -> los cambios tras cada deploy se ven al instante.
# Assets con hash en el nombre (/_astro/, imagenes): inmutables -> cache larga.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|svg|png|jpe?g|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
