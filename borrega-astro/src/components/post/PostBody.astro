---
// Cuerpo del post (HTML de WordPress ya limpio) con la tipografia del sitio.
// Lo comparten las plantillas de trabajo y de blog, que van sobre fondos
// distintos: el blog sobre el fondo oscuro del sitio y el trabajo sobre claro,
// como en los originales de WordPress. Por eso los colores salen de custom
// properties que hereda del contenedor; el default es el del blog y la
// plantilla de trabajo lo pisa.
---

<div class="post-content" data-reveal>
  <slot />
</div>

<style>
  /* Sin barra de acento ni sangria: ninguna de las dos plantillas originales
     las tiene (medido, el borde izquierdo del cuerpo es 0px en las dos). */
  .post-content :global(p) {
    color: var(--post-body-text, #fff);
    margin-bottom: var(--space-2);
  }
  .post-content :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-4);
  }
  .post-content :global(h3) {
    font-size: 1.2rem;
    margin-top: var(--space-3);
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    color: var(--post-body-text, #fff);
    padding-left: 1.4rem;
    margin-bottom: var(--space-2);
  }
  .post-content :global(li) { margin-bottom: 0.4rem; }
  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-2);
    font-style: italic;
    color: var(--post-body-quote, rgba(255, 255, 255, 0.7));
  }
</style>
