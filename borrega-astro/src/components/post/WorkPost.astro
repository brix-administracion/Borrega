---
import GradientHero from '../GradientHero.astro';
import PostBody from './PostBody.astro';
import ShareLinks from './ShareLinks.astro';
import RelatedPosts from './RelatedPosts.astro';
import {
  getWorkPosts,
  getWorkMedia,
  getCountryCategories,
  countryOf,
  galleryOf,
  softwareOf,
  coverOf,
  projectLinkOf,
  postPath,
} from '../../lib/wp';
import type { WPPost } from '../../lib/wp';
import { optimizeImage } from '../../lib/postImages';

interface Props {
  post: WPPost;
  /** HTML del cuerpo, ya limpio. */
  content: string;
}
const { post, content } = Astro.props;
const title = post.title.rendered;

// Ancho de la galeria del proyecto. Las imagenes van apiladas en la columna
// IZQUIERDA, que ocupa el 65% del contenedor (la plantilla original declara
// --width:35% para la columna derecha). 65% de 1320px son ~858px; 1120px cubre
// pantallas densas sin pedir el original (los de WordPress son de 2000px o
// mas). Si el original es mas chico, optimizeImage usa el suyo.
const GALLERY_IMAGE_PX = 1120;

// Imagen de fondo del hero: va a sangre, asi que se pide ancha. Sale del campo
// `cover` de ACF, que es lo que usa la plantilla original — verificado contra
// el HTML en vivo: el background-image del hero es exactamente ese archivo.
const COVER_IMAGE_PX = 1920;

// Logos de software: se muestran a 48px de alto. Solo aplica si alguno NO es
// SVG (hoy todos lo son); 160px cubre 48px de alto en retina con holgura.
const SOFTWARE_LOGO_PX = 160;

// Pedimos los medias de TODOS los trabajos juntos (2 pedidos en todo el build,
// memoizados en wp.ts): no llamar a getMediaByIds desde aca.
const [media, countries, works] = await Promise.all([getWorkMedia(), getCountryCategories(), getWorkPosts()]);

// No todo lo que la clienta subio a la galeria es un mapa de bits: hay un
// .mp4 (un "gif" de web) que sharp no puede procesar y rompe el build. Los
// videos se sirven con <video> y los SVG/GIF tal cual (sharp aplanaria un GIF
// animado); solo JPG, PNG y similares pasan por getImage().
const extensionOf = (url: string) => url.split('?')[0].split('.').pop()?.toLowerCase() ?? '';
const isVideo = (url: string) => ['mp4', 'webm', 'mov'].includes(extensionOf(url));
const isPassthrough = (url: string) => ['svg', 'gif'].includes(extensionOf(url));

const gallery = await Promise.all(
  galleryOf(post, media).map(async (m) => {
    const w = m.media_details?.width;
    const h = m.media_details?.height;
    if (isVideo(m.source_url)) return { media: m, kind: 'video' as const, src: m.source_url, width: w, height: h };
    if (isPassthrough(m.source_url)) return { media: m, kind: 'image' as const, src: m.source_url, width: w, height: h };
    const image = await optimizeImage(m.source_url, w, h, GALLERY_IMAGE_PX);
    return { media: m, kind: 'image' as const, ...image };
  }),
);

// sharp no optimiza los SVG como mapas de bits y pesan casi nada: se sirven
// tal cual desde WordPress. Cualquier otro formato pasa por getImage().
const software = await Promise.all(
  softwareOf(post, media).map(async (m) => {
    if (extensionOf(m.source_url) === 'svg') return { media: m, src: m.source_url, width: m.media_details?.width, height: m.media_details?.height };
    const image = await optimizeImage(m.source_url, m.media_details?.width, m.media_details?.height, SOFTWARE_LOGO_PX);
    return { media: m, ...image };
  }),
);

const country = countryOf(post, countries);
const projectLink = projectLinkOf(post);

// El hero lleva de fondo la portada de ACF. Si un trabajo no tiene `cover`
// (hoy los 20 lo tienen) se cae al degrade, para no quedarse sin hero.
const coverMedia = coverOf(post, media);
const cover =
  coverMedia && !isPassthrough(coverMedia.source_url) && !isVideo(coverMedia.source_url)
    ? await optimizeImage(
        coverMedia.source_url,
        coverMedia.media_details?.width,
        coverMedia.media_details?.height,
        COVER_IMAGE_PX,
      )
    : undefined;

// Los relacionados NO son por afinidad: son los 3 trabajos mas recientes, sin
// el actual (asi lo hace la plantilla original de WordPress).
const related = works.filter((p) => p.id !== post.id).slice(0, 3);
---

{cover ? (
  <header class="work-hero" style={`background-image: url(${cover.src})`}>
    <h1 set:html={title} />
  </header>
) : (
  <GradientHero>
    <Fragment set:html={title} />
  </GradientHero>
)}

<article class="work">
  <div class="container work-columns">
    {gallery.length > 0 && (
      <ul class="work-gallery" aria-label="Galería del proyecto">
        {gallery.map((item, i) => (
          <li>
            {item.kind === 'video' ? (
              <video src={item.src} width={item.width} height={item.height} autoplay muted loop playsinline preload="metadata" aria-label={item.media.alt_text || ''} />
            ) : (
              <a href={item.src} target="_blank" rel="noopener">
                <img
                  src={item.src}
                  alt={item.media.alt_text || ''}
                  width={item.width}
                  height={item.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </a>
            )}
          </li>
        ))}
      </ul>
    )}

    <div class="work-info">
      <div class="work-info-head">
        <h2 set:html={title} />
        {country && (
          <img class="work-flag" src={`/flags/${country.iso}.svg`} width="64" height="43" alt={country.name} />
        )}
      </div>

      <PostBody>
        <Fragment set:html={content} />
      </PostBody>

      {projectLink && (
        <p class="project-link"><a href={projectLink} class="btn" target="_blank" rel="noopener">VER EL PROYECTO</a></p>
      )}

      {software.length > 0 && (
        <section class="software">
          <h4>SOFTWARE</h4>
          <ul>
            {software.map((s) => (
              <li>
                <img src={s.src} alt={s.media.alt_text || ''} width={s.width} height={s.height} loading="lazy" />
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="cta-card">
        <img src="/images/deco/ok.png" alt="" class="cta-deco" width="40" height="58" />
        <h3>¿Por qué no agendar una <span class="accent-pink">consultoría gratis</span>?</h3>
        <a href="/reservar-consulta" class="btn">AGENDAR REUNIÓN</a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="post-footer">
      <a href="/nuestro-trabajo" class="back-link">&larr; Volver a nuestro trabajo</a>
      <ShareLinks path={postPath(post)} />
    </div>
  </div>
</article>

<RelatedPosts heading="Más proyectos" posts={related} />

<style>
  /* El hero lleva de fondo la portada de ACF, igual que la plantilla original:
     500px de alto minimo, la imagen centrada y recortada, y el titulo encima.
     El velo oscuro no esta en el original — ahi la imagen va duplicada en dos
     capas — pero sin el, un titulo blanco sobre una portada clara queda
     ilegible, y las portadas las elige la clienta. */
  .work-hero {
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-3);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    position: relative;
  }
  .work-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.28);
  }
  .work-hero h1 {
    position: relative;
    margin: 0;
    max-width: 18ch;
    text-align: center;
    color: var(--color-white);
    text-wrap: balance;
  }

  /* Seccion de dos columnas: la galeria a la izquierda y la ficha a la derecha.
     La plantilla original declara --width:35% para la columna derecha, asi que
     el reparto es 65/35. Fondo claro y texto #1B1B1B, que es el color de texto
     del tema de WordPress. */
  .work {
    background: var(--color-white);
    color: #1b1b1b;
    padding-block: var(--space-5) var(--space-4);
    /* Las lee PostBody, que por defecto pinta para fondo oscuro (el blog).
       La barra de acento se apaga: el original no la tiene en el trabajo. */
    --post-body-text: rgba(27, 27, 27, 0.85);
    --post-body-quote: rgba(27, 27, 27, 0.7);
    --post-body-rule: transparent;
    --post-body-indent: 0;
  }
  .work-columns {
    display: grid;
    grid-template-columns: 65fr 35fr;
    gap: var(--space-4);
    align-items: start;
  }

  .work-info-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    border-bottom: 1px solid rgba(27, 27, 27, 0.25);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .work-info-head h2 { margin: 0; text-wrap: balance; }
  .work-flag { width: 64px; height: auto; flex-shrink: 0; }

  .work-gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .work-gallery a { display: block; border-radius: var(--radius-md); overflow: hidden; }
  .work-gallery img,
  .work-gallery video { width: 100%; height: auto; display: block; border-radius: var(--radius-md); }

  .project-link { margin-top: var(--space-3); }
  .project-link .btn { border-color: currentColor; color: inherit; }

  .software { margin-top: var(--space-4); }
  .software h4 {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }
  .software ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .software img { height: 48px; width: auto; display: block; }

  /* La tarjeta es oscura aunque la seccion sea clara, asi que fija su propio
     color de texto en vez de heredar el #1b1b1b del contenedor. */
  .cta-card {
    position: relative;
    background: #16161a;
    color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-3) var(--space-3);
    text-align: center;
    margin-top: var(--space-4);
  }
  .cta-deco { position: absolute; top: -20px; left: var(--space-3); }
  .cta-card h3 { font-size: 1.4rem; margin-bottom: var(--space-2); }
  .accent-pink { color: var(--color-pink); }
  .cta-card .btn { border-color: var(--color-white); }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    border-top: 1px solid rgba(27, 27, 27, 0.2);
    padding-top: var(--space-3);
    margin-top: var(--space-4);
  }
  .back-link { color: inherit; font-weight: 600; }

  /* Las dos columnas se apilan cuando dejan de entrar: con la galeria al 65%
     de una pantalla angosta las imagenes quedan demasiado chicas, y la ficha
     de la derecha en 35% no da ni para una linea de texto comoda. */
  @media (max-width: 900px) {
    .work-columns { grid-template-columns: 1fr; }
    .work-hero { min-height: 340px; }
  }
</style>
