---
import GradientHero from '../GradientHero.astro';
import PostBody from './PostBody.astro';
import ShareLinks from './ShareLinks.astro';
import RelatedPosts from './RelatedPosts.astro';
import {
  getWorkPosts,
  getWorkMedia,
  getCountryCategories,
  countryOf,
  galleryOf,
  softwareOf,
  projectLinkOf,
  postPath,
} from '../../lib/wp';
import type { WPPost } from '../../lib/wp';
import { optimizeImage } from '../../lib/postImages';

interface Props {
  post: WPPost;
  /** HTML del cuerpo, ya limpio. */
  content: string;
}
const { post, content } = Astro.props;
const title = post.title.rendered;

// Ancho de la galeria del proyecto: las imagenes van apiladas a UNA columna, a
// todo el ancho de la columna de contenido (.work-column, 960px de maximo).
// 1280px = 960px x 1.33, suficiente para pantallas densas sin pedir el
// original (las de WordPress son de 2000px o mas). Si el original es mas
// chico, optimizeImage usa el suyo.
const GALLERY_IMAGE_PX = 1280;

// Logos de software: se muestran a 48px de alto. Solo aplica si alguno NO es
// SVG (hoy todos lo son); 160px cubre 48px de alto en retina con holgura.
const SOFTWARE_LOGO_PX = 160;

// Pedimos los medias de TODOS los trabajos juntos (2 pedidos en todo el build,
// memoizados en wp.ts): no llamar a getMediaByIds desde aca.
const [media, countries, works] = await Promise.all([getWorkMedia(), getCountryCategories(), getWorkPosts()]);

// No todo lo que la clienta subio a la galeria es un mapa de bits: hay un
// .mp4 (un "gif" de web) que sharp no puede procesar y rompe el build. Los
// videos se sirven con <video> y los SVG/GIF tal cual (sharp aplanaria un GIF
// animado); solo JPG, PNG y similares pasan por getImage().
const extensionOf = (url: string) => url.split('?')[0].split('.').pop()?.toLowerCase() ?? '';
const isVideo = (url: string) => ['mp4', 'webm', 'mov'].includes(extensionOf(url));
const isPassthrough = (url: string) => ['svg', 'gif'].includes(extensionOf(url));

const gallery = await Promise.all(
  galleryOf(post, media).map(async (m) => {
    const w = m.media_details?.width;
    const h = m.media_details?.height;
    if (isVideo(m.source_url)) return { media: m, kind: 'video' as const, src: m.source_url, width: w, height: h };
    if (isPassthrough(m.source_url)) return { media: m, kind: 'image' as const, src: m.source_url, width: w, height: h };
    const image = await optimizeImage(m.source_url, w, h, GALLERY_IMAGE_PX);
    return { media: m, kind: 'image' as const, ...image };
  }),
);

// sharp no optimiza los SVG como mapas de bits y pesan casi nada: se sirven
// tal cual desde WordPress. Cualquier otro formato pasa por getImage().
const software = await Promise.all(
  softwareOf(post, media).map(async (m) => {
    if (extensionOf(m.source_url) === 'svg') return { media: m, src: m.source_url, width: m.media_details?.width, height: m.media_details?.height };
    const image = await optimizeImage(m.source_url, m.media_details?.width, m.media_details?.height, SOFTWARE_LOGO_PX);
    return { media: m, ...image };
  }),
);

const country = countryOf(post, countries);
const projectLink = projectLinkOf(post);

// Los relacionados NO son por afinidad: son los 3 trabajos mas recientes, sin
// el actual (asi lo hace la plantilla original de WordPress).
const related = works.filter((p) => p.id !== post.id).slice(0, 3);
---

<GradientHero>
  <Fragment set:html={title} />
  <Fragment slot="subtitle">
    {country && (
      <span class="country"><img src={`/flags/${country.iso}.svg`} width="18" height="12" alt="" /> {country.name}</span>
    )}
  </Fragment>
</GradientHero>

<article class="work">
  <div class="container work-column">
    {gallery.length > 0 && (
      <ul class="work-gallery" aria-label="Galería del proyecto">
        {gallery.map((item, i) => (
          <li>
            {item.kind === 'video' ? (
              <video src={item.src} width={item.width} height={item.height} autoplay muted loop playsinline preload="metadata" aria-label={item.media.alt_text || ''} />
            ) : (
              <a href={item.src} target="_blank" rel="noopener">
                <img
                  src={item.src}
                  alt={item.media.alt_text || ''}
                  width={item.width}
                  height={item.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </a>
            )}
          </li>
        ))}
      </ul>
    )}

    <PostBody>
      <Fragment set:html={content} />
    </PostBody>

    {projectLink && (
      <p class="project-link"><a href={projectLink} class="btn" target="_blank" rel="noopener">VER EL PROYECTO</a></p>
    )}

    {software.length > 0 && (
      <section class="software">
        <h4>SOFTWARE</h4>
        <ul>
          {software.map((s) => (
            <li>
              <img src={s.src} alt={s.media.alt_text || ''} width={s.width} height={s.height} loading="lazy" />
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="cta-card">
      <img src="/images/deco/ok.png" alt="" class="cta-deco" width="40" height="58" />
      <h3>¿Por qué no agendar una <span class="accent-pink">consultoría gratis</span>?</h3>
      <a href="/reservar-consulta" class="btn">AGENDAR REUNIÓN</a>
    </div>

    <div class="post-footer">
      <a href="/nuestro-trabajo" class="back-link">&larr; Volver a nuestro trabajo</a>
      <ShareLinks path={postPath(post)} />
    </div>
  </div>
</article>

<RelatedPosts heading="Más proyectos" posts={related} />

<style>
  .work {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-5) var(--space-4);
  }
  .work-column { max-width: 1008px; }
  .country { display: inline-flex; align-items: center; gap: 0.4rem; }

  .work-gallery {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .work-gallery a { display: block; border-radius: var(--radius-md); overflow: hidden; }
  .work-gallery img,
  .work-gallery video { width: 100%; height: auto; display: block; border-radius: var(--radius-md); }

  .project-link { margin-top: var(--space-3); }
  .project-link .btn { border-color: var(--color-white); }

  .software { margin-top: var(--space-4); }
  .software h4 {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }
  .software ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .software img { height: 48px; width: auto; display: block; }

  .cta-card {
    position: relative;
    background: #16161a;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-align: center;
    margin-top: var(--space-4);
  }
  .cta-deco { position: absolute; top: -20px; left: var(--space-3); }
  .cta-card h3 { font-size: 1.4rem; margin-bottom: var(--space-2); }
  .accent-pink { color: var(--color-pink); }
  .cta-card .btn { border-color: var(--color-white); }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-3);
    margin-top: var(--space-4);
  }
  .back-link { color: var(--color-white); font-weight: 600; }
</style>
