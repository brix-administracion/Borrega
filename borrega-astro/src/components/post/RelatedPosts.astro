---
import type { WPPost } from '../../lib/wp';
import { featuredImageOf, tileImageOf, postPath } from '../../lib/wp';
import { optimizeImage } from '../../lib/postImages';

interface Props {
  heading: string;
  posts: WPPost[];
}
const { heading, posts } = Astro.props;

// Ancho de la tarjeta: tres columnas dentro del contenedor (1320px menos
// margenes) dan ~410px; en una columna, justo antes del corte de 700px, llega
// a ~650px. 640px cubre el caso de escritorio en retina sin pedir el original.
const RELATED_IMAGE_PX = 640;

const cards = await Promise.all(
  posts.map(async (post) => {
    const media = featuredImageOf(post);
    let thumb;
    if (media) {
      const item = tileImageOf(media);
      thumb = await optimizeImage(item.src, item.width, item.height, RELATED_IMAGE_PX);
    }
    return { post, media, thumb, title: post.title.rendered.replace(/<[^>]+>/g, '') };
  }),
);
---

{cards.length > 0 && (
  <section class="related">
    <div class="container">
      <h2>{heading}</h2>
      <ul class="related-grid">
        {cards.map(({ post, media, thumb, title }) => (
          <li class="related-card">
            <a href={postPath(post)} aria-label={title}>
              {media && thumb && (
                <img src={thumb.src} alt={media.alt_text || title} loading="lazy" width={thumb.width} height={thumb.height} />
              )}
              <span class="related-caption" set:html={post.title.rendered} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .related {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-4) var(--space-5);
  }
  .related h2 { font-size: 1.6rem; margin-bottom: var(--space-3); }
  .related-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: 1fr;
  }
  .related-card { overflow: hidden; border-radius: 12px; aspect-ratio: 4 / 3; }
  .related-card a { position: relative; display: block; width: 100%; height: 100%; color: var(--color-white); }
  .related-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease-out);
  }
  .related-card:hover img { transform: scale(1.06); }
  .related-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-3) var(--space-2) var(--space-2);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0));
  }
  @media (min-width: 700px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
