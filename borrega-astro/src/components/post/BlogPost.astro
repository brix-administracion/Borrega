---
import GradientHero from '../GradientHero.astro';
import PostBody from './PostBody.astro';
import ShareLinks from './ShareLinks.astro';
import RelatedPosts from './RelatedPosts.astro';
import { getBlogPosts, featuredImageOf, tileImageOf, postPath } from '../../lib/wp';
import type { WPPost } from '../../lib/wp';
import { optimizeImage } from '../../lib/postImages';

interface Props {
  post: WPPost;
  /** HTML del cuerpo, ya limpio. */
  content: string;
  isPublic: boolean;
}
const { post, content, isPublic } = Astro.props;
const img = featuredImageOf(post);
const title = post.title.rendered;

// Ancho de la imagen destacada: en escritorio la barra lateral mide ~405px y en
// pantallas angostas la imagen ocupa una columna de hasta ~835px. 840px cubre
// ambos casos sin pedir el original de WordPress (el de playstation-arg es
// un PNG de 13 MB).
const FEATURED_IMAGE_PX = 840;

const featured = img
  ? await (() => {
      const item = tileImageOf(img);
      return optimizeImage(item.src, item.width, item.height, FEATURED_IMAGE_PX);
    })()
  : undefined;

// Los relacionados NO son por afinidad: son los 3 articulos mas recientes del
// blog, sin el actual (asi lo hace la plantilla original de WordPress).
const related = (await getBlogPosts()).filter((p) => p.id !== post.id).slice(0, 3);
---

<GradientHero>
  <Fragment set:html={title} />
</GradientHero>

<article class="post">
  <div class="container post-grid">
    <PostBody>
      <Fragment set:html={content} />
      <img src="/images/deco/borrega-signature.png" alt="Börrega" class="signature" width="140" height="70" />
    </PostBody>

    <aside class="post-sidebar">
      {img && featured && (
        <img class="post-featured" src={featured.src} alt={img.alt_text || ''} width={featured.width} height={featured.height} loading="eager" />
      )}
      <div class="cta-card">
        <img src="/images/deco/ok.png" alt="" class="cta-deco" width="40" height="58" />
        <h2>Solicitar <span class="accent-pink">más información</span></h2>
        <p>Si el artículo te pareció interesante y quisieras que nos comuniquemos para trabajar juntos no dudes en agendar tu reunión.</p>
        <a href="/reservar-consulta" class="btn">AGENDAR REUNIÓN</a>
      </div>
    </aside>
  </div>

  <div class="container post-footer">
    {isPublic ? (
      <a href="/borrega-blog" class="back-link">&larr; Volver a todos los Posts</a>
    ) : <span />}
    <ShareLinks path={postPath(post)} />
  </div>
</article>

<RelatedPosts heading="Más artículos" posts={related} />

<style>
  .post {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-5);
  }
  .post-grid { display: grid; gap: var(--space-4); }
  .signature { margin-top: var(--space-4); }

  .post-featured {
    width: 100%;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .cta-card {
    position: relative;
    background: #16161a;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-align: center;
    margin-top: var(--space-3);
  }
  .cta-deco {
    position: absolute;
    top: -20px;
    left: var(--space-3);
  }
  .cta-card h2 { font-size: 1.4rem; }
  .accent-pink { color: var(--color-pink); }
  .cta-card p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    margin-block: var(--space-2);
  }
  .cta-card .btn { border-color: var(--color-white); }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-3);
    margin-top: var(--space-4);
  }
  .back-link { color: var(--color-white); font-weight: 600; }

  @media (min-width: 900px) {
    .post-grid { grid-template-columns: 2fr 1fr; align-items: start; }
    .post-sidebar { position: sticky; top: calc(var(--space-3) + 70px); }
  }
</style>
