  .cta-card p { color: rgba(255,255,255,0.75); max-width: 32ch; margin-inline: auto; }
  .cta-card .btn { margin-top: var(--space-2); }
  .deco-kiss {
    position: absolute;
    top: -30px;
    right: 24px;
    width: 44px;
    height: auto;
  }

  .squares { display: none; }
  @media (min-width: 1100px) {
