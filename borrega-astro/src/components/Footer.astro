
<!-- data-reveal va en el inner, NUNCA en la section: la section es la que pinta
     el fondo negro, y [data-reveal] arranca en opacity 0. Puesto ahi, hasta que
     reveal.ts agregaba .is-visible se veia el body (blanco) por detras. El fondo
     tiene que quedar fuera de la animacion; solo entra el contenido. -->
<section class="cta-band">
  <div class="cta-band-inner container" data-reveal>
    <div class="squares squares-left" aria-hidden="true">
      {Array.from({length: 8}).map(() => <span class="sq sq-purple"></span>)}
    </div>
    <div class="squares squares-right" aria-hidden="true">
      {Array.from({length: 8}).map(() => <span class="sq sq-orange"></span>)}
    </div>

    <div class="cta-card">
      <h3>Estamos para <span class="accent-pink">ayudar</span></h3>
      <p>Contactanos, contanos que necesitás. Trabajemos juntos.</p>
      <a href="mailto:info@borregastudio.com" class="btn">ESCRIBINOS</a>
    </div>
    <div class="cta-card">
      <img src="/images/deco/blob-kiss.png" alt="" class="deco-kiss" width="60" height="76" id="deco-kiss" />
      <h3>¿Querés sumarte al <span class="accent-pink">rebaño</span>?</h3>
      <p>Si te sobran ganas, si creés que tenés algo que aportar o si sólo te querés tirar el lance.</p>
      <a href="/sumate" class="btn">POSTULATE</a>
    </div>
  </div>
</section>

<script>
  import { initMouseTilt } from '../scripts/mouseTilt';
  initMouseTilt('#deco-kiss');
</script>

<footer class="site-footer">
  <div class="footer-inner">
    <!-- El logotipo de marca es una imagen, no texto: la "börrega" del original
         no es Playfair sino la sans redondeada del logo. Este asset ya estaba en
         el repo desde la migracion, sin usar, y mide lo mismo que el del sitio. -->
    <img src="/images/brand/logo-white.png" alt="Börrega Studio" width="261" height="73" class="footer-logo" />
    <p class="footer-contact">
      BUENOS AIRES | <a href="mailto:info@borregastudio.com">INFO@BORREGASTUDIO.COM</a> |
      <!-- En el original el telefono es texto plano. Lo dejamos como tel: porque
           sin subrayado y del mismo color se ve identico, y mantiene el tap-to-llamar. -->
      <a href="tel:+5491171327309">+54 9 11 71327309</a>
    </p>
  </div>
  <!-- El original no tiene linea legal (su unico link a privacidad vive en el
       banner de cookies, que este sitio estatico no tiene). Dejamos un link
       discreto para que /politicas-de-privacidad no quede huerfana. -->
  <p class="footer-legal"><a href="/politicas-de-privacidad">Políticas de privacidad</a></p>
</footer>

<style>
