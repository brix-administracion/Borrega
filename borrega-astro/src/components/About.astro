---
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/images/about-photo.png';
---
<section id="nosotros" class="about">
  <div class="container about-grid">
    <div class="about-copy" data-reveal>
      <h2>Somos Börrega.</h2>
      <p>
        Una agencia <strong>creativa</strong> de <strong>marketing</strong> y
        <strong>branding estratégico</strong> que transforma necesidades en resultados.
        No vendemos servicios sueltos ni tenemos la llave del éxito: tenemos todas las
        herramientas para construirlo.
      </p>
      <p>
        Trabajamos con procesos propios —<strong>STRATA®</strong>,
        <strong>Creativity as a System</strong> y <strong>Human in the loop</strong>—,
        liderados por Pilar Puig Lómez, Founder y Directora Creativa, cuya visión estratégica y
        experiencia internacional son parte esencial de cada proyecto.
      </p>
      <p class="rebano">No seguimos al rebaño.</p>
      <a href="https://www.linkedin.com/" target="_blank" rel="noopener" class="btn btn-dark">VER LINKEDIN</a>
    </div>
    <div class="about-media" data-reveal>
      <img src="/images/deco/meeh.png" alt="" class="pill-meeh" width="140" height="46" />
      <Image src={aboutPhoto} alt="Equipo Börrega" width={640} height={428} loading="lazy" />
      <img src="/images/deco/cursor.png" alt="" class="deco-cursor" width="28" height="46" />
    </div>
  </div>
</section>

<style>
  .about { background: var(--color-bg); color: var(--color-white); padding-block: var(--space-6); }
  .about-grid { display: grid; gap: var(--space-4); align-items: center; }
  .about-copy h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .about-copy p { opacity: 0.85; max-width: 52ch; }
  .about-copy p strong { color: var(--color-white); opacity: 1; }
  .rebano {
    font-family: var(--font-display);
    font-size: 1.4rem;
    opacity: 1 !important;
    margin-block: var(--space-3) var(--space-2);
  }
  .btn-dark { border-color: var(--color-white); }
  .about-media { position: relative; }
  .about-media :global(img):not(.pill-meeh):not(.deco-cursor) {
    border-radius: var(--radius-md);
    width: 100%;
    height: auto;
    aspect-ratio: 640 / 428;
    object-fit: cover;
    background: #2a2a2a;
  }
  .pill-meeh {
    position: absolute;
    top: -18px;
    left: var(--space-3);
    z-index: 1;
    width: 120px;
    height: auto;
  }
  .deco-cursor {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 26px;
    height: auto;
  }

  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  }
</style>
