---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Props {
  images: ImageMetadata[];
  // 'masonry' (fotografía) o 'justified' (animación): el sitio original usa
  // un widget de galería de Elementor distinto en cada página.
  layout?: 'masonry' | 'justified';
}
const { images, layout = 'masonry' } = Astro.props;
const total = images.length;
---

<section class="gallery-section">
  <div class="container">
    <div class:list={['gallery', `gallery--${layout}`]} data-reveal>
      {
        images.map((img, i) => (
          // Sin JS el enlace sigue abriendo el archivo original (mejora progresiva);
          // con JS el script intercepta el clic y abre el <dialog>.
          <a
            href={img.src}
            target="_blank"
            rel="noopener"
            class="gallery-item"
            data-lightbox-trigger
            data-full={img.src}
            data-alt={`Imagen ${i + 1} de ${total}`}
            aria-label={`Ampliar imagen ${i + 1} de ${total}`}
            // Proporción de cada imagen: la usa el layout justified para repartir el ancho.
            style={`--ratio: ${(img.width / img.height).toFixed(4)}`}
          >
            <Image
              src={img}
              alt=""
              width={640}
              loading={i < 6 ? 'eager' : 'lazy'}
              widths={[320, 480, 640]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<Lightbox />

<style>
  .gallery-section {
    background: var(--color-white);
    padding-block: var(--space-4);
  }
  .gallery-item {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm, 6px);
  }
  .gallery-item :global(img) {
    display: block;
    transition: transform 0.35s ease;
  }
  .gallery-item:hover :global(img) {
    transform: scale(1.05);
  }

  /* ---------- masonry (fotografía): 4 / 2 / 1 columnas, gap 10px ----------
     Diferencia con el original: las columnas CSS llenan la columna 1 de arriba
     a abajo antes de pasar a la 2, mientras que el masonry JS de Elementor
     coloca cada ítem de izquierda a derecha en la columna más corta. El orden de
     lectura cambia; se acepta para no cargar una librería de masonry en JS. */
  .gallery--masonry {
    columns: 4;
    column-gap: 10px;
  }
  @media (max-width: 1024px) {
    .gallery--masonry {
      columns: 2;
    }
  }
  @media (max-width: 640px) {
    .gallery--masonry {
      columns: 1;
    }
  }
  .gallery--masonry .gallery-item {
    break-inside: avoid;
    margin-bottom: 10px;
  }
  /* Proporción natural (sin recorte). height:auto es obligatorio: los atributos
     width/height de <Image> actúan como pista y, sin esto, ganan al CSS. */
  .gallery--masonry .gallery-item :global(img) {
    width: 100%;
    height: auto;
  }

  /* ---------- justified (animación): filas de 200px (150px en tablet) ----------
     Técnica flexbox: cada ítem crece según su proporción. Última fila: se usa un
     relleno invisible (::after) con flex-grow enorme en lugar de limitar el grow
     de los ítems, porque así la última fila conserva el mismo alto y casi el
     mismo ancho natural de sus imágenes sin estirarse al 100%. */
  .gallery--justified {
    --row-h: 200px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 1024px) {
    .gallery--justified {
      --row-h: 150px;
    }
  }
  .gallery--justified::after {
    content: '';
    flex-grow: 1000000;
    flex-basis: 0;
  }
  .gallery--justified .gallery-item {
    height: var(--row-h);
    flex-grow: var(--ratio);
    flex-basis: calc(var(--ratio) * var(--row-h));
    max-width: 100%;
  }
  .gallery--justified .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
