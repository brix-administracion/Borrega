---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  // 'masonry' (fotografía) o 'justified' (animación): el sitio original usa
  // un widget de galería de Elementor distinto en cada página.
  layout?: 'masonry' | 'justified';
}
const { images, layout = 'masonry' } = Astro.props;
const total = images.length;
---

<section class="gallery-section">
  <div class="container">
    <div class:list={['gallery', `gallery--${layout}`]} data-reveal>
      {
        images.map((img, i) => (
          // Sin JS el enlace sigue abriendo el archivo original (mejora progresiva);
          // con JS el script intercepta el clic y abre el <dialog>.
          <a
            href={img.src}
            target="_blank"
            rel="noopener"
            class="gallery-item"
            data-lightbox-trigger
            data-full={img.src}
            data-alt={`Imagen ${i + 1} de ${total}`}
            aria-label={`Ampliar imagen ${i + 1} de ${total}`}
            // Proporción de cada imagen: la usa el layout justified para repartir el ancho.
            style={`--ratio: ${(img.width / img.height).toFixed(4)}`}
          >
            <Image
              src={img}
              alt=""
              width={640}
              loading={i < 6 ? 'eager' : 'lazy'}
              widths={[320, 480, 640]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- Un único <dialog> por página, reutilizado para todas las imágenes. -->
<dialog class="lightbox" aria-label="Visor de imagen ampliada" data-lightbox>
  <div class="lightbox-frame">
    <img class="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-close" aria-label="Cerrar imagen ampliada" data-lightbox-close>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const bigImg = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
  let trigger: HTMLElement | null = null;

  if (dialog && bigImg) {
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-trigger]').forEach((link) => {
      link.addEventListener('click', (e) => {
        // Si el navegador no soporta showModal, se deja actuar al enlace normal.
        if (typeof dialog.showModal !== 'function') return;
        e.preventDefault();
        trigger = link;
        bigImg.src = link.dataset.full ?? link.href;
        bigImg.alt = link.dataset.alt ?? '';
        dialog.showModal();
        // Foco dentro del diálogo: el botón de cerrar es el primer control alcanzable.
        dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.focus();
      });
    });

    // El <dialog> ocupa toda la pantalla y es transparente: un clic que cae sobre
    // él (o su marco) y no sobre la imagen o el botón equivale a clic en el fondo.
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lightbox-frame') || t.closest('[data-lightbox-close]')) {
        dialog.close();
      }
    });

    // 'close' se dispara también con Esc, así que el foco se devuelve en un solo lugar.
    dialog.addEventListener('close', () => {
      bigImg.removeAttribute('src');
      trigger?.focus();
      trigger = null;
    });
  }
</script>

<style>
  .gallery-section {
    background: var(--color-white);
    padding-block: var(--space-4);
  }
  .gallery-item {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm, 6px);
  }
  .gallery-item :global(img) {
    display: block;
    transition: transform 0.35s ease;
  }
  .gallery-item:hover :global(img) {
    transform: scale(1.05);
  }

  /* ---------- masonry (fotografía): 4 / 2 / 1 columnas, gap 10px ----------
     Diferencia con el original: las columnas CSS llenan la columna 1 de arriba
     a abajo antes de pasar a la 2, mientras que el masonry JS de Elementor
     coloca cada ítem de izquierda a derecha en la columna más corta. El orden de
     lectura cambia; se acepta para no cargar una librería de masonry en JS. */
  .gallery--masonry {
    columns: 4;
    column-gap: 10px;
  }
  @media (max-width: 1024px) {
    .gallery--masonry {
      columns: 2;
    }
  }
  @media (max-width: 640px) {
    .gallery--masonry {
      columns: 1;
    }
  }
  .gallery--masonry .gallery-item {
    break-inside: avoid;
    margin-bottom: 10px;
  }
  /* Proporción natural (sin recorte). height:auto es obligatorio: los atributos
     width/height de <Image> actúan como pista y, sin esto, ganan al CSS. */
  .gallery--masonry .gallery-item :global(img) {
    width: 100%;
    height: auto;
  }

  /* ---------- justified (animación): filas de 200px (150px en tablet) ----------
     Técnica flexbox: cada ítem crece según su proporción. Última fila: se usa un
     relleno invisible (::after) con flex-grow enorme en lugar de limitar el grow
     de los ítems, porque así la última fila conserva el mismo alto y casi el
     mismo ancho natural de sus imágenes sin estirarse al 100%. */
  .gallery--justified {
    --row-h: 200px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 1024px) {
    .gallery--justified {
      --row-h: 150px;
    }
  }
  .gallery--justified::after {
    content: '';
    flex-grow: 1000000;
    flex-basis: 0;
  }
  .gallery--justified .gallery-item {
    height: var(--row-h);
    flex-grow: var(--ratio);
    flex-basis: calc(var(--ratio) * var(--row-h));
    max-width: 100%;
  }
  .gallery--justified .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  .lightbox-frame {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: #111;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:focus-visible {
    outline: 3px solid var(--color-pink, #f0f);
    outline-offset: 2px;
  }
  /* Un <dialog> modal no bloquea el scroll de la página por sí solo. */
  :global(html:has(dialog.lightbox[open])) {
    overflow: hidden;
  }
</style>
