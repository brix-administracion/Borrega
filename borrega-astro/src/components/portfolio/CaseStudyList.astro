---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CaseStudy {
  title: string;
  text: string;
  attribution?: string;
  images: ImageMetadata[];
}
interface Props {
  items: CaseStudy[];
}
const { items } = Astro.props;
---

<section class="case-studies">
  <div class="cases">
    {
      items.map((item) => (
        <article class="case" data-reveal>
          <h2>{item.title}</h2>
          <hr class="case-rule" />
          <div class="case-copy">
            <p>{item.text}</p>
            {item.attribution && <p class="attribution">{item.attribution}</p>}
          </div>
          <div class="case-images">
            {item.images.map((img) => (
              <Image src={img} alt={item.title} width={640} loading="lazy" widths={[320, 480, 640]} sizes="(max-width: 640px) 88vw, 500px" />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .case-studies {
    background: var(--color-white);
    padding-block: var(--space-4);
  }
  /* Rejilla 50/50 dentro de 1140px, como el original. Un caso sin pareja (el
     último, si la cantidad es impar) ocupa ambas columnas por sí solo: así un
     octavo caso futuro sigue funcionando sin tratar ningún nombre aparte. */
  .cases {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4) 0;
    max-width: 1140px;
    margin-inline: auto;
    padding-inline: var(--space-2);
  }
  @media (min-width: 900px) {
    .cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Sin gutter: el 88% interno de cada caso ya deja el aire lateral. */
      padding-inline: 0;
    }
    .case:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .case {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .case h2 {
    font-family: var(--font-display);
    font-size: 32px;
    text-align: center;
    color: rgb(27, 27, 27);
    margin: 0;
  }
  /* Regla bajo el título: 88% de la columna, 1px negro (medido en el original). */
  .case-rule {
    width: 88%;
    margin: var(--space-2) 0;
    border: 0;
    border-top: 1px solid rgb(0, 0, 0);
  }
  .case-copy {
    width: 88%;
  }
  .case-copy p {
    font-family: var(--font-text);
    font-size: 16px;
    line-height: 24px;
    text-align: left;
    color: rgb(27, 27, 27);
    margin: 0 0 var(--space-1);
  }
  .attribution {
    font-style: italic;
  }
  .case-images {
    width: 88%;
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  /* Proporción natural, sin recorte. height:auto es obligatorio: los atributos
     width/height de <Image> actúan como pista y, sin esto, ganan al CSS. */
  .case-images :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
