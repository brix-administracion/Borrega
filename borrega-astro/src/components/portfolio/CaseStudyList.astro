---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CaseStudy {
  title: string;
  text: string;
  attribution?: string;
  images: ImageMetadata[];
}
interface Props {
  items: CaseStudy[];
}
const { items } = Astro.props;
---

<section class="case-studies">
  <div class="container">
    {
      items.map((item) => (
        <article class="case" data-reveal>
          <div class="case-images" data-count={item.images.length}>
            {item.images.map((img) => (
              <Image src={img} alt={item.title} width={640} loading="lazy" widths={[320, 480, 640]} sizes="(max-width: 640px) 100vw, 50vw" />
            ))}
          </div>
          <div class="case-copy">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            {item.attribution && <p class="attribution">{item.attribution}</p>}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .case-studies {
    background: var(--color-white);
    padding-block: var(--space-4);
  }
  .case {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid rgba(27, 27, 27, 0.1);
  }
  .case:last-child {
    border-bottom: none;
  }
  .case-images {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }
  .case-images[data-count='2'],
  .case-images[data-count='3'] {
    grid-template-columns: repeat(2, 1fr);
  }
  .case-images :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm, 6px);
    display: block;
  }
  .case-copy h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-1);
  }
  .case-copy p {
    color: rgba(27, 27, 27, 0.75);
    line-height: 1.6;
  }
  .attribution {
    margin-top: var(--space-1);
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(27, 27, 27, 0.5);
  }
  @media (min-width: 900px) {
    .case {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-4);
    }
  }
</style>
