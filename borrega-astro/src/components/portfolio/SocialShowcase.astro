---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';
import phoneBg from '../../assets/images/portfolio/rrss/fondo-celular.png';
import sectionBg from '../../assets/images/portfolio/rrss/fondo-seccion.jpg';

interface Group {
  mockup: ImageMetadata;
  posts: ImageMetadata[];
}
interface Props {
  groups: Group[];
}
const { groups } = Astro.props;

// Los fondos se usan como `background-image` de CSS, que necesita una URL y no
// un <img>: por eso getImage() y no <Image> (mismo criterio que borrega-blog.astro).
// Se optimizan una sola vez y se reusan en las 6 tarjetas.
const phone = await getImage({ src: phoneBg, width: 1200, format: 'webp', quality: 80 });
const section = await getImage({ src: sectionBg, width: 1200, format: 'webp', quality: 70 });

// Elementor llama "slideshow" a este fondo, pero cada tarjeta tiene exactamente
// UNA imagen, así que nunca anima. Es un fondo estático a propósito: no
// reconstruir temporizador ni fundido para una sola imagen.
const total = groups.length * 3;
let n = 0;
---

<section class="social-showcase" style={`background-image: url(${section.src})`}>
  <div class="container">
    {
      groups.map((group) => (
        <div class="showcase-block" data-reveal>
          <div class="showcase-card" style={`background-image: url(${phone.src})`}>
            <div class="mockup">
              <Image src={group.mockup} alt="" width={800} loading="lazy" widths={[400, 640, 800]} sizes="(max-width: 640px) 72vw, 800px" />
            </div>
          </div>
          <div class="posts">
            {group.posts.map((post) => {
              n += 1;
              return (
                // Sin JS el enlace abre el archivo original; con JS lo intercepta el <dialog>.
                <a
                  href={post.src}
                  target="_blank"
                  rel="noopener"
                  class="post"
                  data-lightbox-trigger
                  data-full={post.src}
                  data-alt={`Publicación ${n} de ${total}`}
                  aria-label={`Ampliar publicación ${n} de ${total}`}
                >
                  <Image src={post} alt="" width={420} loading="lazy" widths={[213, 320, 420]} sizes="(max-width: 640px) 33vw, 213px" />
                </a>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</section>

<Lightbox />

<style>
  /* scroll es el valor por defecto; se deja explícito porque el original lo fija. */
  .social-showcase {
    background-color: #f4f4f5;
    background-size: cover;
    background-position: 50% 50%;
    background-attachment: scroll;
    padding-block: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .showcase-block {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
  }
  /* 1003×776 medido a 1440px => proporción ≈1.29, sin padding. */
  .showcase-card {
    width: 100%;
    max-width: 1003px;
    aspect-ratio: 1003 / 776;
    padding: 0;
    background-color: var(--color-white);
    background-size: cover;
    background-position: 50% 50%;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* La composición ocupa el 80% del ancho de la tarjeta, centrada. */
  .mockup {
    width: 80%;
  }
  .mockup :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Mismo ancho que la tarjeta: en el original la fila de posteos va al ras de
     los bordes del mockup (medido: tarjeta 200..1203, posteos 210..1193), no
     centrada y mas angosta. */
  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 100%;
    max-width: 1003px;
  }
  .post {
    display: block;
    overflow: hidden;
  }
  .post :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1 / 1;
    display: block;
  }
</style>
