---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Group {
  mockup: ImageMetadata;
  posts: ImageMetadata[];
}
interface Props {
  groups: Group[];
}
const { groups } = Astro.props;
---

<section class="social-showcase">
  <div class="container">
    {
      groups.map((group) => (
        <div class="showcase-card" data-reveal>
          <div class="mockup">
            <Image src={group.mockup} alt="" width={640} loading="lazy" widths={[320, 480, 640]} sizes="(max-width: 640px) 90vw, 500px" />
          </div>
          <div class="posts">
            {group.posts.map((post) => (
              <Image src={post} alt="" width={420} loading="lazy" widths={[213, 320, 420]} sizes="(max-width: 640px) 33vw, 213px" />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .social-showcase {
    background: #f4f4f5;
    padding-block: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .showcase-card {
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-3);
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .mockup {
    max-width: 460px;
    width: 100%;
  }
  .mockup :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 100%;
    max-width: 900px;
  }
  .posts :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1 / 1;
    display: block;
  }
</style>
