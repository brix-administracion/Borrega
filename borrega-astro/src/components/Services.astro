---
const services = [
  { label: 'Publicidad', color: 'default' },
  { label: 'Diseño gráfico', color: 'accent' },
  { label: 'Desarrollo web', color: 'default' },
  { label: 'Branding', color: 'teal' },
  { label: 'Producción gráfica', color: 'default' },
  { label: 'Redes Sociales', color: 'default' },
  { label: 'Packaging', color: 'default' },
  { label: 'Animación', color: 'default' },
  { label: 'Estrategia', color: 'green' },
  { label: 'Mailing', color: 'default' },
  { label: '3D', color: 'default' },
  { label: 'Creatividad', color: 'pink' },
  { label: 'Editorial', color: 'default' },
  { label: 'Marketing Digital', color: 'orange' },
];
---

<section id="servicios" class="services">
  <div class="container">
    <h2 class="services-title" data-reveal>
      Llevamos a las marcas a ser <span class="gradient-text">top of mind</span> de su cliente ideal.
    </h2>
    <div class="services-intro" data-reveal>
      <p>
        Somos Börrega, una agencia creativa de marketing y branding estratégico que transforma
        necesidades en resultados.
      </p>
      <p>
        Con base en Buenos Aires y un equipo senior, boutique y multidisciplinario brindamos
        estrategia y ejecución desde el mismo lugar, sin intermediarios. Acompañamos marcas bajo
        modalidad fee mensual (Börrega Inside) o por proyecto, adaptándonos a cada etapa del negocio.
      </p>
      <p>
        <strong>No seguimos al rebaño:</strong> pensamos distinto, actuamos con precisión y nos
        gusta hacerlo bien.
      </p>
    </div>
    <div
      class="services-fall"
      data-falling-tags
      data-reveal
      data-stagger="0.04"
      data-order="sequence"
      data-gravity="1"
      data-bounciness="0.15"
      data-restore-delay="2.5"
    >
      <ul class="services-cloud">
        {services.map((s) => (
          <li class:list={['tag', `tag-${s.color}`]} data-piece>{s.label}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .services { background: var(--color-bg); color: var(--color-white); padding-block: var(--space-5); }
  .services-title {
    font-size: clamp(2rem, 5vw, 3rem);
    /* Medido: por debajo de 32ch el salto de linea cae en medio de "top of
       mind" y la frase queda partida entre las dos lineas. Con 34ch el corte
       va donde el diseno original: linea 1 termina en "top of mind". */
    max-width: 34ch;
    margin: 0 auto var(--space-3);
    text-align: center;
  }
  /* El degrade se pinta sobre el bounding box del inline: si la frase se parte
     en dos lineas, cada fragmento recibe su propio tramo y el corte se nota.
     El nowrap la mantiene como una unidad, asi el degrade queda entero sea
     cual sea el ancho. */
  .gradient-text {
    white-space: nowrap;
    background: linear-gradient(90deg, var(--color-secondary), var(--color-pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .services-intro { max-width: 62ch; margin: 0 auto var(--space-4); text-align: center; opacity: 0.85; }
  /* El proyecto no resetea el margen de <p>, lo fijamos para no depender
     del default del navegador. */
  .services-intro p { margin: 0 0 var(--space-2); }
  .services-intro p:last-child { margin-bottom: 0; }
  /* Contenedor fisico de FallingTags: position explicito porque las piezas
     se anclan a el con position:absolute (no depender del transform del
     reveal). El padding-bottom es el espacio de caida: el piso de la
     simulacion queda al final del padding-box. */
  .services-fall { position: relative; padding-bottom: 140px; }
  .services-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }
  .tag {
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-white);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .tag-default { background: transparent; }
  .tag-accent { background: var(--color-accent); color: var(--color-primary); border-color: var(--color-accent); }
  .tag-teal { background: var(--color-teal); color: var(--color-primary); border-color: var(--color-teal); }
  .tag-green { background: var(--color-green); color: var(--color-white); border-color: var(--color-green); }
  .tag-pink { background: var(--color-pink); color: var(--color-primary); border-color: var(--color-pink); }
  .tag-orange { background: var(--color-orange); color: var(--color-white); border-color: var(--color-orange); }
</style>

<script>
  import { initFallingTags } from '../scripts/fallingTags';
  initFallingTags();
</script>
