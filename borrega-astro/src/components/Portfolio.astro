---
import DomeGallery from './DomeGallery.astro';
import { getWorkPosts, getCountryCategories, countryOf, featuredImageOf, tileImageOf, postPath } from '../lib/wp';

// "Nuestro trabajo": TODOS los proyectos, leidos en vivo de WordPress en cada
// build (los posts que NO pertenecen al blog). Si la clienta agrega o borra un
// proyecto en WP, el domo se ajusta solo al reconstruir — no hay nada
// hardcodeado aca, ni la cantidad.
const [works, countries] = await Promise.all([getWorkPosts(), getCountryCategories()]);

const items = works.flatMap((post) => {
  const img = featuredImageOf(post);
  // Sin featured image no hay tile posible; el proyecto igual tiene su pagina
  // de detalle, solo no entra al domo.
  if (!img) return [];
  const label = post.title.rendered.replace(/<[^>]+>/g, '');
  return [
    {
      src: tileImageOf(img),
      alt: img.alt_text || label,
      titleHtml: post.title.rendered,
      label,
      href: postPath(post),
      country: countryOf(post, countries),
    },
  ];
});
---

<section id="trabajo" class="portfolio">
  <div class="container">
    <h2 class="portfolio-title" data-reveal>Nuestro trabajo</h2>
  </div>

  <!-- El domo va a sangre y SIN data-reveal: pinta su propio fondo (igual que
       el Footer y ServiceHighlights) y ademas necesita medir su tamaño real al
       cargar para calcular el radio. -->
  <div class="portfolio-dome">
    <DomeGallery items={items} />
  </div>

  <div class="container">
    <a href="/nuestro-trabajo" class="portfolio-more" data-reveal>VER MÁS</a>
  </div>
</section>

<style>
  .portfolio {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-6);
  }
  .portfolio-title {
    text-align: center;
    margin-bottom: var(--space-4);
  }
  .portfolio-dome {
    position: relative;
    height: clamp(420px, 70vh, 760px);
    margin-bottom: var(--space-4);
  }
  .portfolio-more {
    display: block;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: var(--space-3);
  }
</style>
