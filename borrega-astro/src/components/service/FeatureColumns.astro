---
interface Column {
  heading: string;
  intro?: string;
  items: string[];
}
interface Props {
  columns: Column[];
}
const { columns } = Astro.props;
---

<section class="feature-columns">
  <div class="container cols-grid">
    {columns.map((col) => (
      <div class="col" data-reveal>
        <h2>{col.heading}</h2>
        {col.intro && <p class="intro">{col.intro}</p>}
        <ul>
          {col.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-columns {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-5);
  }
  .cols-grid {
    display: grid;
    gap: var(--space-4);
  }
  .col {
    border-top: 2px dotted var(--color-accent);
    padding-top: var(--space-2);
  }
  .col h2 {
    font-size: 1.5rem;
    text-align: center;
    margin-bottom: var(--space-2);
  }
  .intro { opacity: 0.8; margin-bottom: var(--space-2); }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .col li {
    background: #16161a;
    border-radius: 10px;
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .cols-grid { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  }
</style>
