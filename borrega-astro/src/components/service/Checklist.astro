---
interface Props {
  heading?: string;
  /** h2 opcional sobre todo el bloque (ej. "¿Es para vos?"), aparte del titulo lateral. */
  sectionHeading?: string;
  /**
   * Nivel del titulo lateral. Por defecto h2, que es lo que es en los originales
   * de auditoria-comunicacion y externalizacion-servicios ("Nuestro servicio ...
   * es para tu empresa si:"). Se pasa 3 cuando la tarjeta cuelga de un h2 de
   * seccion, como el "Es para vos si…" de auditoria-redes-sociales: ahi el
   * original usa un parrafo y dos h2 hermanos romperian el esquema.
   */
  headingLevel?: 2 | 3;
  items: string[];
  tone?: 'band' | 'plain';
}
const { heading, sectionHeading, headingLevel = 2, items, tone = 'band' } = Astro.props;
---

<section class:list={['checklist', `tone-${tone}`]}>
  {sectionHeading && (
    <div class="container">
      <h2 class="section-heading" data-reveal>{sectionHeading}</h2>
    </div>
  )}
  <div class="container checklist-grid">
    {heading && (headingLevel === 3 ? <h3 data-reveal>{heading}</h3> : <h2 data-reveal>{heading}</h2>)}
    <ul data-reveal>
      {items.map((item) => (
        <li>
          <span class="check" aria-hidden="true">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tone-band {
    background: var(--color-secondary);
    color: var(--color-white);
    padding-block: var(--space-4);
  }
  .tone-plain {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-3);
  }
  .checklist-grid {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }
  /* El rotulo de la tarjeta es h3 y el de la seccion h2; comparten tamaño
     porque en el original se ven igual. */
  .checklist h2,
  .checklist h3 {
    font-size: 1.5rem;
    max-width: 20ch;
  }
  .checklist h2.section-heading { max-width: none; text-align: center; margin-bottom: var(--space-3); }
  .checklist ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .checklist li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-weight: 600;
  }
  .check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
  }
  .tone-plain .check { background: var(--color-secondary); }

  @media (min-width: 800px) {
    .checklist-grid { grid-template-columns: 1fr 1.4fr; }
  }
</style>
