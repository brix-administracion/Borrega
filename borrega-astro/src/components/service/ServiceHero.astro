---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import decoWand from '../../assets/images/service/deco-wand.png';
import decoCursor from '../../assets/images/service/deco-cursor.png';
import decoArrow from '../../assets/images/service/deco-arrow.png';

interface Props {
  title: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'glow' | 'blue' | 'photo';
  /** Foto real del mascot/hero (solo variant="photo"). */
  image?: ImageMetadata;
  /** Iconitos decorativos (varita, cursor, flecha) que tiene el sitio real en los heroes "glow". */
  decorIcons?: boolean;
}
const {
  title,
  subtitle,
  primaryCta = { label: 'AGENDAR REUNIÓN', href: '/reservar-consulta' },
  secondaryCta,
  variant = 'glow',
  image,
  decorIcons = false,
} = Astro.props;
---

<section class:list={['service-hero', `variant-${variant}`]}>
  {
    variant === 'photo' && image && (
      <div class="hero-photo">
        <Image src={image} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
      </div>
    )
  }
  {
    decorIcons && (
      <>
        <img src={decoWand.src} alt="" class="deco deco-wand" width="36" height="36" />
        <img src={decoCursor.src} alt="" class="deco deco-cursor" width="34" height="34" />
        <img src={decoArrow.src} alt="" class="deco deco-arrow" width="30" height="30" />
      </>
    )
  }
  <div class="container">
    <h1 data-reveal set:html={title} />
    {subtitle && <p class="subtitle" data-reveal>{subtitle}</p>}
    <div class="ctas" data-reveal>
      <a href={primaryCta.href} class="btn btn-accent">{primaryCta.label}</a>
      {secondaryCta && <a href={secondaryCta.href} class="btn">{secondaryCta.label}</a>}
    </div>
  </div>
</section>

<style>
  .service-hero {
    color: var(--color-white);
    text-align: center;
    padding-block: var(--space-6);
    position: relative;
    overflow: hidden;
  }
  .variant-glow {
    background:
      radial-gradient(ellipse 55% 55% at 38% 25%, rgba(121, 47, 255, 0.4), transparent 65%),
      radial-gradient(ellipse 55% 55% at 65% 30%, rgba(247, 105, 48, 0.3), transparent 65%),
      var(--color-bg);
  }
  .variant-blue {
    background: linear-gradient(180deg, #0c1420 0%, #000000 100%);
  }
  .variant-photo {
    padding-block: var(--space-6) var(--space-5);
    min-height: 560px;
    display: flex;
    align-items: center;
    background: var(--color-bg);
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.55) 65%, var(--color-bg) 100%);
  }
  .variant-photo .container {
    position: relative;
    z-index: 1;
  }
  .deco {
    position: absolute;
    z-index: 1;
    opacity: 0.9;
    pointer-events: none;
  }
  .deco-wand { top: 30%; left: 8%; }
  .deco-cursor { top: 62%; right: 10%; transform: rotate(10deg); }
  .deco-arrow { top: 20%; right: 14%; }
  @media (max-width: 700px) {
    .deco { display: none; }
  }
  .service-hero h1 {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    max-width: 26ch;
    margin-inline: auto;
  }
  .service-hero :global(em) {
    font-style: italic;
  }
  .subtitle {
    max-width: 44ch;
    margin: var(--space-2) auto 0;
    opacity: 0.85;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .btn-accent {
    background: var(--color-accent);
    color: var(--color-primary);
    border-color: var(--color-accent);
  }
  .btn-accent:hover { background: transparent; color: var(--color-white); border-color: var(--color-white); }
</style>
