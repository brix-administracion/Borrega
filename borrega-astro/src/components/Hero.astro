---
// Hero del home. Reconstruido segun el sitio actual (borregastudio.com):
// titular "top of mind", intro de la agencia, y marquee de logos de clientes.
const clients = [
  { name: 'Telecentro', logo: '/images/logos/telecentro.png' },
  { name: 'Roemmers', logo: '/images/logos/roemmers.svg' },
  { name: 'Galicia', logo: '/images/logos/galicia.svg' },
  { name: 'Megatlon', logo: '/images/logos/megatlon.svg' },
  { name: 'DOT Hotels', logo: '/images/logos/dot.svg' },
  { name: 'Sofía Clerici', logo: '/images/logos/sofia-clerici.svg' },
  { name: 'Perpetuo', logo: '/images/logos/perpetuo.svg' },
  { name: 'Sparty', logo: '/images/logos/sparty.svg' },
  { name: 'Sonoff', logo: '/images/logos/sonoff.svg' },
  { name: 'Uplifting', logo: '/images/logos/uplifting.svg' },
  { name: 'Five', logo: '/images/logos/five.svg' },
  { name: 'Jason.l', logo: '/images/logos/jason.svg' },
  { name: 'CINQ', logo: '/images/logos/cinq.svg' },
  { name: 'Campanita', logo: '/images/logos/campanita.svg' },
  { name: 'Fábrica de Invitaciones', logo: '/images/logos/fabrica-invitaciones.svg' },
  { name: 'Osba', logo: '/images/logos/osba.png' },
  { name: 'Nutribaby', logo: '/images/logos/nutribaby.png' },
];
---

<section class="hero" id="top">
  <div class="container hero-content">
    <h1 data-reveal>
      Llevamos a las marcas a ser <span class="hl">top of mind</span> de su cliente ideal.
    </h1>
    <p class="hero-lead" data-reveal>
      Somos Börrega, una agencia creativa de marketing y branding estratégico que transforma
      necesidades en resultados.
    </p>
    <p class="hero-text" data-reveal>
      Con base en Buenos Aires y un equipo senior, boutique y multidisciplinario, brindamos
      estrategia y ejecución desde el mismo lugar, sin intermediarios. Acompañamos marcas bajo
      modalidad fee mensual (Börrega Inside) o por proyecto, adaptándonos a cada etapa del negocio.
    </p>
    <p class="hero-rebano" data-reveal>
      <strong>No seguimos al rebaño:</strong> pensamos distinto, actuamos con precisión y nos
      gusta hacerlo bien.
    </p>
    <div class="hero-ctas" data-reveal>
      <a href="/contacto" class="btn btn-accent">CONSULTORÍA GRATIS</a>
      <a href="/#trabajo" class="btn">NUESTRO TRABAJO</a>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...clients, ...clients].map((c) => (
        <span class="marquee-item">
          <img src={c.logo} alt={c.name} loading="lazy" width="120" height="40" />
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 55% at 25% 15%, rgba(121, 47, 255, 0.45), transparent 60%),
      radial-gradient(ellipse 55% 50% at 80% 10%, rgba(247, 105, 48, 0.3), transparent 60%),
      var(--color-bg);
    color: var(--color-white);
  }
  .hero-content {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .hero h1 {
    font-size: clamp(2.1rem, 6vw, 4rem);
    max-width: 20ch;
  }
  .hero .hl { color: var(--color-accent); font-style: italic; }
  .hero-lead {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    max-width: 48ch;
    margin-top: var(--space-2);
  }
  .hero-text,
  .hero-rebano {
    max-width: 62ch;
    opacity: 0.85;
    margin-top: var(--space-2);
  }
  .hero-rebano strong { color: var(--color-white); opacity: 1; }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .btn-accent {
    background: var(--color-accent);
    color: var(--color-primary);
    border-color: var(--color-accent);
  }
  .btn-accent:hover { background: transparent; color: var(--color-white); border-color: var(--color-white); }

  .marquee {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.4);
    overflow: hidden;
    padding-block: var(--space-3);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: var(--space-5);
    align-items: center;
    animation: hero-marquee 45s linear infinite;
  }
  .marquee-item { display: flex; align-items: center; height: 34px; }
  .marquee-item img {
    height: 100%;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }
  @keyframes hero-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; flex-wrap: wrap; }
  }
</style>
