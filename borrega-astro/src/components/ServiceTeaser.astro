---
// Teaser de servicio para el home (Börrega AuditStrat / Börrega Inside).
// El texto es un resumen; el "MÁS INFO" lleva a la landing completa.
interface Props {
  title: string;
  subtitle?: string;
  bodyHtml: string;
  ctaLabel?: string;
  ctaHref: string;
  accent?: 'violet' | 'orange';
}
const { title, subtitle, bodyHtml, ctaLabel = 'MÁS INFO', ctaHref, accent = 'violet' } = Astro.props;
---

<section class:list={['teaser', `accent-${accent}`]}>
  <div class="container teaser-inner" data-reveal>
    <span class="teaser-bar" aria-hidden="true"></span>
    <div class="teaser-body">
      <h2>{title}</h2>
      {subtitle && <p class="teaser-sub">{subtitle}</p>}
      <p class="teaser-text" set:html={bodyHtml} />
      <a href={ctaHref} class="btn">{ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .teaser { background: var(--color-bg); color: var(--color-white); padding-block: var(--space-5); }
  .teaser-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    max-width: 80ch;
  }
  .teaser-bar {
    width: 4px;
    border-radius: 4px;
    align-self: stretch;
    background: var(--color-secondary);
  }
  .accent-orange .teaser-bar { background: var(--color-orange); }
  .teaser h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); margin-bottom: var(--space-1); }
  .teaser-sub {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .teaser-text { opacity: 0.85; margin-bottom: var(--space-3); max-width: 66ch; }
  .teaser-text :global(strong) { color: var(--color-white); opacity: 1; }
  .teaser .btn { border-color: var(--color-white); }

  @media (max-width: 640px) {
    .teaser-inner { grid-template-columns: 1fr; }
    .teaser-bar { width: 40px; height: 4px; }
  }
</style>
