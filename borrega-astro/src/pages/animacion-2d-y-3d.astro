---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHero from '../components/portfolio/PortfolioHero.astro';
import PhotoGallery from '../components/portfolio/PhotoGallery.astro';
import ServiceFinalCTA from '../components/service/ServiceFinalCTA.astro';

import anim01 from '../assets/images/portfolio/animacion/anim-01.jpg';
import anim02 from '../assets/images/portfolio/animacion/anim-02.jpg';
import anim03 from '../assets/images/portfolio/animacion/anim-03.jpg';
import anim04 from '../assets/images/portfolio/animacion/anim-04.jpg';
import anim05 from '../assets/images/portfolio/animacion/anim-05.jpg';
import anim06 from '../assets/images/portfolio/animacion/anim-06.jpg';
import anim07 from '../assets/images/portfolio/animacion/anim-07.jpg';
import anim08 from '../assets/images/portfolio/animacion/anim-08.jpg';
import anim09 from '../assets/images/portfolio/animacion/anim-09.png';

const images = [anim01, anim02, anim03, anim04, anim05, anim06, anim07, anim08, anim09];
---

<BaseLayout title="Portfolio Animación 2D y 3D — Börrega" description="Animación 2D y 3D para marcas, campañas y contenido digital.">
  <PortfolioHero title="Portfolio Animación 2D y 3D" />
  <PhotoGallery images={images} />
  <ServiceFinalCTA titleHtml="Pedir <span class='hl'>Cotización</span>" ctaLabel="PEDIR COTIZACIÓN" ctaHref="/contacto" />
</BaseLayout>

<style>
  :global(.hl) { color: var(--color-pink); }
</style>
