---
import PageLayout from '../layouts/PageLayout.astro';
import { getAllPages } from '../lib/wp';
import { cleanElementorHtml } from '../lib/cleanContent';
import { ALLOWED_PAGE_SLUGS } from '../lib/pageSlugs';

export async function getStaticPaths() {
  // Allowlist: solo las paginas de WP listadas en src/lib/pageSlugs.ts se
  // generan con esta plantilla generica. Todo lo demas que haya o aparezca
  // en WordPress se ignora a proposito — el diseño vive en Astro y WP es
  // deposito del blog y los trabajos nada mas. Lista compartida con
  // sitemap.xml.ts para no duplicarla ni que se desincronicen.
  const ALLOWED = new Set(ALLOWED_PAGE_SLUGS);
  const pages = await getAllPages();
  return pages
    .filter((p) => ALLOWED.has(p.slug))
    .map((p) => ({
      params: { slug: p.slug },
      props: { page: p },
    }));
}

const { page } = Astro.props;
const content = cleanElementorHtml(page.content.rendered);
const title = page.title.rendered.replace(/&#8211;|–/g, '-').replace(/&amp;/g, '&');
---

<PageLayout title={title}>
  <Fragment set:html={content} />
</PageLayout>
