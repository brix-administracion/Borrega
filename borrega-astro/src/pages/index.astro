---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import ServiceHighlights from '../components/ServiceHighlights.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
---

{/* La description sale textual del original: es copy de SEO escrito a proposito,
    no una frase de relleno. Sin ella el home caia al default generico del layout. */}
<BaseLayout
  title="Börrega Studio — Diseño, estrategia y creatividad"
  description="Agencia creativa de marketing y branding estratégico con base en Buenos Aires. Llevamos a las marcas a ser top of mind de su cliente ideal."
>
  <Hero />
  <Services />
  <About />
  <ServiceHighlights />
  <Portfolio />
  <Testimonials />
</BaseLayout>
