---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHero from '../components/portfolio/PortfolioHero.astro';
import PhotoGallery from '../components/portfolio/PhotoGallery.astro';
import ServiceFinalCTA from '../components/service/ServiceFinalCTA.astro';

import foto02 from '../assets/images/portfolio/fotografia/foto-02.jpg';
import foto03 from '../assets/images/portfolio/fotografia/foto-03.jpg';
import foto04 from '../assets/images/portfolio/fotografia/foto-04.jpg';
import foto05 from '../assets/images/portfolio/fotografia/foto-05.jpg';
import foto06 from '../assets/images/portfolio/fotografia/foto-06.jpg';
import foto07 from '../assets/images/portfolio/fotografia/foto-07.jpg';
import foto08 from '../assets/images/portfolio/fotografia/foto-08.jpg';
import foto09 from '../assets/images/portfolio/fotografia/foto-09.jpg';
import foto10 from '../assets/images/portfolio/fotografia/foto-10.jpg';
import foto11 from '../assets/images/portfolio/fotografia/foto-11.jpg';
import foto12 from '../assets/images/portfolio/fotografia/foto-12.jpg';
import foto13 from '../assets/images/portfolio/fotografia/foto-13.jpg';
import foto14 from '../assets/images/portfolio/fotografia/foto-14.jpg';
import foto15 from '../assets/images/portfolio/fotografia/foto-15.jpg';

// foto-01.jpg se descartó a propósito: no está en la galería original del sitio
// (que tiene 14 imágenes). No volver a agregarla por error.
const images = [foto02, foto03, foto04, foto05, foto06, foto07, foto08, foto09, foto10, foto11, foto12, foto13, foto14, foto15];
---

<BaseLayout title="Portfolio Fotografía — Börrega" description="Fotografía de producto, retrato y contenido para marcas.">
  <PortfolioHero title="Portfolio Fotografía" />
  <PhotoGallery images={images} layout="masonry" />
  <ServiceFinalCTA titleHtml="Pedir <span class='hl'>Cotización</span>" ctaLabel="PEDIR COTIZACIÓN" ctaHref="/contacto" />
</BaseLayout>

<style>
  :global(.hl) { color: var(--color-pink); }
</style>
