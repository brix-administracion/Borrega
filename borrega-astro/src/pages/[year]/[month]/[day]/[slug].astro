---
import { getImage } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogPost from '../../../../components/post/BlogPost.astro';
import WorkPost from '../../../../components/post/WorkPost.astro';
import { getAllPosts, getBlogCategoryId, isPublicBlogPost, featuredImageOf, tileImageOf, postPath } from '../../../../lib/wp';
import { cleanElementorHtml, plainTextFromHtml } from '../../../../lib/cleanContent';

export async function getStaticPaths() {
  // OJO: traemos TODOS los posts (no solo los del blog publico). La
  // clienta usa varios posts de WordPress para compartir informacion por
  // fuera de la web (mail, redes, etc.), sin que figuren en el listado de
  // /borrega-blog/. Esos posts igual necesitan una URL real: si no los
  // generamos aca, cualquier link que la clienta ya haya compartido deja
  // de funcionar. Lo que SI cambia por categoria es: (a) si aparecen
  // listados en /borrega-blog/ y (b) si son indexables por buscadores.
  const [posts, blogCategoryId] = await Promise.all([getAllPosts(), getBlogCategoryId()]);
  return posts.map((post) => {
    const path = postPath(post); // /YYYY/MM/DD/slug/
    const [, year, month, day, slug] = path.split('/');
    return {
      params: { year, month, day, slug },
      props: { post, isPublic: isPublicBlogPost(post, blogCategoryId) },
    };
  });
}

const { post, isPublic } = Astro.props;
const img = featuredImageOf(post);
const content = cleanElementorHtml(post.content.rendered);
const title = post.title.rendered;

// La plantilla sale de la MISMA senal que el noindex: un post con la categoria
// `blogpost` es del blog; el resto es un trabajo (o un post privado que la
// clienta comparte por fuera, que en WordPress tambien usa la plantilla de
// trabajo). Las URLs no cambian: getStaticPaths sigue generando los 30.
const template = isPublic ? 'blog' : 'work';

// og:image la leen scrapers externos (WhatsApp, LinkedIn, Twitter, Slack) y no
// un navegador, asi que no comparte la imagen del articulo: va aparte.
//
// - JPEG y no webp: es el unico formato que aceptan todos. LinkedIn en
//   particular lo viene manejando mal, y es justo donde se comparte el trabajo
//   de una agencia.
// - 1200px es el ancho que recomienda Open Graph para la preview grande; por
//   debajo de 600 varias plataformas caen a una miniatura.
// - URL absoluta: el layout emite og:image tal cual, una relativa se rompe.
//
// Antes se mandaba el original de WordPress, que para playstation-arg son 13 MB
// de PNG: ningun scraper lo previsualizaba.
const OG_IMAGE_PX = 1200;

let ogImage = img?.source_url;
if (img) {
  const item = tileImageOf(img);
  const result = await getImage({
    src: item.src,
    width: OG_IMAGE_PX,
    height: Math.round(((item.height ?? 630) / (item.width ?? 1200)) * OG_IMAGE_PX),
    format: 'jpeg',
    quality: 78,
  });
  ogImage = new URL(result.src, Astro.site).href;
}
const excerpt = plainTextFromHtml(post.excerpt.rendered);
---

<BaseLayout title={`${title} — Börrega Studio`} description={excerpt} ogImage={ogImage} noindex={!isPublic}>
  {template === 'blog' ? (
    <BlogPost post={post} content={content} isPublic={isPublic} />
  ) : (
    <WorkPost post={post} content={content} />
  )}
</BaseLayout>
