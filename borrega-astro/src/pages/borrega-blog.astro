---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientHero from '../components/GradientHero.astro';
import { getBlogPosts, featuredImageOf, postPath } from '../lib/wp';

const posts = await getBlogPosts();
---

<BaseLayout title="Blog — Börrega Studio" description="Novedades, conclusiones y temas de interés.">
  <GradientHero>
    Blog
    <Fragment slot="subtitle">Novedades, conclusiones y temas de interés.</Fragment>
  </GradientHero>

  <section class="blog-list">
    <div class="container">
      <ul class="blog-grid">
        {posts.map((post) => {
          const img = featuredImageOf(post);
          const excerpt = post.excerpt.rendered.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
          return (
            <li class="blog-card" data-reveal>
              <a href={postPath(post)} class="blog-card-link">
                {img && (
                  <img
                    src={img.source_url}
                    alt={img.alt_text || ''}
                    loading="lazy"
                    width="600"
                    height="400"
                  />
                )}
                <div class="blog-card-body">
                  <h2 set:html={post.title.rendered} />
                  <p>{excerpt}</p>
                  <span class="read-more">Leer más</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-list {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-5);
  }
  .blog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .blog-card {
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .blog-card-link {
    display: block;
    color: inherit;
    height: 100%;
  }
  .blog-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .blog-card-body {
    padding: var(--space-3);
  }
  .blog-card-body h2 {
    font-size: 1.3rem;
    margin-bottom: var(--space-1);
  }
  .blog-card-body p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.75);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .read-more {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .blog-card:hover .read-more { text-decoration: underline; }

  @media (min-width: 700px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
