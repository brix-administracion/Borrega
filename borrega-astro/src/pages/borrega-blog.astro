---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientHero from '../components/GradientHero.astro';
import { getImage } from 'astro:assets';
import { getBlogPosts, featuredImageOf, tileImageOf, postPath } from '../lib/wp';
import { plainTextFromHtml } from '../lib/cleanContent';

const posts = await getBlogPosts();

// Ancho de la miniatura: la tarjeta mide como maximo ~650px (una columna, justo
// antes del corte de 700px; en escritorio son ~400px). 800px cubre eso en 1x y
// el caso comun de escritorio en retina, sin pedir el original de WordPress.
const CARD_IMAGE_PX = 800;

// Una optimizacion por post con getImage() y no con <Image>: el patron y la
// razon (descargas repetidas, inferSize prohibido) estan en DomeGallery.astro.
// Sin `fit`: sharp redimensiona por ancho y respeta el aspecto real; si WP no
// dio medidas se usa un aspecto de referencia en vez de inferSize.
const optimized = new Map<number, { src: string; width: number; height: number }>();
await Promise.all(
  posts.map(async (post) => {
    const media = featuredImageOf(post);
    if (!media) return;
    const item = tileImageOf(media);
    const result = await getImage({
      src: item.src,
      width: CARD_IMAGE_PX,
      height: Math.round(((item.height ?? 2) / (item.width ?? 3)) * CARD_IMAGE_PX),
      format: 'webp',
      quality: 72,
    });
    optimized.set(post.id, {
      src: result.src,
      width: Number(result.attributes.width ?? CARD_IMAGE_PX),
      height: Number(result.attributes.height ?? CARD_IMAGE_PX),
    });
  }),
);
---

<BaseLayout title="Blog — Börrega Studio" description="Novedades, conclusiones y temas de interés.">
  <GradientHero>
    Blog
    <Fragment slot="subtitle">Novedades, conclusiones y temas de interés.</Fragment>
  </GradientHero>

  <section class="blog-list">
    <div class="container">
      <ul class="blog-grid">
        {posts.map((post) => {
          const img = featuredImageOf(post);
          const thumb = optimized.get(post.id);
          const excerpt = plainTextFromHtml(post.excerpt.rendered);
          return (
            <li class="blog-card" data-reveal>
              <a href={postPath(post)} class="blog-card-link">
                {img && thumb && (
                  <img
                    src={thumb.src}
                    alt={img.alt_text || ''}
                    loading="lazy"
                    width={thumb.width}
                    height={thumb.height}
                  />
                )}
                <div class="blog-card-body">
                  <h2 set:html={post.title.rendered} />
                  <p>{excerpt}</p>
                  <span class="read-more">Leer más</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-list {
    background: var(--color-bg);
    color: var(--color-white);
    padding-block: var(--space-5);
  }
  /* Medidas tomadas del listado original con getComputedStyle, no estimadas:
     separacion 20px horizontal y 25px vertical, tarjeta de borde #f0f0f0 sin
     redondeo y 10px de padding, miniatura cuadrada de 348px, titulo de 21px
     con 20px de aire abajo, extracto de 14px y "Leer más" de 12px/600. */
  .blog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    column-gap: 20px;
    row-gap: 25px;
  }
  .blog-card {
    border: 1px solid #f0f0f0;
    padding: 10px;
  }
  .blog-card-link {
    display: block;
    color: inherit;
    height: 100%;
  }
  /* `height: auto` es imprescindible: sin el, el atributo height del <img>
     (que lleva las medidas reales para reservar el espacio) le gana al
     aspect-ratio y la miniatura sale con el alto del original. */
  .blog-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .blog-card-body {
    padding: var(--space-2) 30px var(--space-2) 0;
  }
  .blog-card-body h2 {
    font-size: 21px;
    margin-bottom: 20px;
  }
  /* El extracto va entero: el original no lo recorta. */
  .blog-card-body p {
    font-size: 14px;
    color: #f0f0f0;
  }
  .read-more {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--color-accent);
    font-weight: 600;
    font-size: 12px;
  }
  .blog-card:hover .read-more { text-decoration: underline; }

  @media (min-width: 700px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
