---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import sheepInside from '../assets/images/service/sheep-inside.png';
import IntroStatement from '../components/service/IntroStatement.astro';
import Checklist from '../components/service/Checklist.astro';
import FeatureColumns from '../components/service/FeatureColumns.astro';
import FAQAccordion from '../components/service/FAQAccordion.astro';
import ServiceFinalCTA from '../components/service/ServiceFinalCTA.astro';
---

<BaseLayout title="Börrega Inside — Externalización de Servicios" description="Un equipo de comunicación externo que trabaja de forma continua, integrada y estratégica.">
  <ServiceHero
    title="Börrega Inside"
    variant="photo"
    image={sheepInside}
    primaryCta={{ label: 'AGENDAR REUNIÓN', href: '/reservar-consulta' }}
    secondaryCta={{ label: 'VER SERVICIOS', href: '/#servicios' }}
  />

  <IntroStatement
    eyebrowHtml="Muchas empresas necesitan resolver su comunicación diaria, pero <span class='hl-purple'>no cuentan con un equipo interno completo</span> o no quieren asumir los costos y la complejidad de armarlo. Ahí es donde entra la <span class='hl'>Externalización de Servicios</span> (también conocido como Outsourcing)."
    conclusionHtml="Börrega Inside es <span class='hl'>la solución.</span>"
  />

  <Checklist
    heading="Nuestro servicio de externalización es para tu empresa si:"
    items={[
      'Necesitás resolver comunicación todos los meses',
      'Querés un equipo sin armarlo internamente',
      'Buscás continuidad y criterio estratégico',
    ]}
  />

  {/* "Cómo trabajamos" es un h2 en el original, con tres parrafos debajo. Venia
      todo fusionado en un solo parrafo con el titulo en negrita, y por eso
      faltaba del esquema de titulos de la pagina. */}
  <IntroStatement
    headingHtml="Cómo trabajamos"
    eyebrowHtml={[
      'Creamos un presupuesto personalizado combinando diferentes servicios según las necesidades reales de tu empresa.',
      'El resultado es un <strong>equipo de comunicación externo</strong> que trabaja de forma continua, integrada y estratégica.',
      'Nos involucramos como parte del equipo: escuchamos, asesoramos y trabajamos codo a codo.',
    ]}
  />

  <FeatureColumns
    columns={[
      {
        heading: 'Qué incluye',
        items: [
          'Planificación mensual',
          'Servicios combinados según necesidad',
          'Acompañamiento continuo',
          'Interacción directa con equipos internos',
          'Asesoramiento estratégico',
        ],
      },
      {
        heading: 'Por qué conviene',
        items: [
          'Equipo asignado — Profesionales Senior o superior que conocen tu marca',
          'Servicio escalable — Ajuste según necesidad y crecimiento',
          'Fee mensual — Costos predecibles y sin sorpresas',
        ],
      },
    ]}
  />

  <FAQAccordion
    items={[
      { question: '¿Qué es la externalización de servicios de comunicación?', answer: 'Es un modelo donde un estudio externo funciona como el departamento de comunicación de una empresa. La externalización de servicios de comunicación práctica estratégica de delegar funciones o procesos relacionados con la comunicación a proveedores externos especializados, permitiendo a la empresa principal enfocarse en su negocio central, reducir costos y acceder a tecnología y experiencia de punta.' },
      {
        question: '¿Reemplaza a un equipo interno?',
        answer: 'Puede reemplazarlo o complementarlo, según las necesidades del negocio.',
        body: [
          { list: [
            '<strong>Sí, puede reemplazarlo:</strong> En algunos casos, una empresa puede decidir eliminar su departamento interno de comunicación y contratar a una agencia para que lo reemplace por completo.',
            '<strong>O puede complementarlo:</strong> Alternativamente, puede trabajar junto a un equipo interno para potenciar áreas específicas (ej., una agencia gestiona redes sociales mientras el equipo interno maneja comunicados de prensa).',
            '<strong>Beneficios clave:</strong> A menudo, es más rentable que mantener un equipo completo, ofrece economías de escala y permite acceso inmediato a tecnología y talento especializado.',
          ] },
        ],
      },
      {
        question: '¿El servicio es fijo o flexible?',
        answer: 'Es flexible y escalable. En nuestro caso es escalable con 30 días de anticipación.',
        body: [
          'La externalización de servicios de comunicación es inherentemente <strong>flexible</strong>, permitiendo a las empresas convertir costos fijos en variables, adaptarse rápidamente a necesidades cambiantes (escalabilidad) y acceder a experiencia especializada sin compromisos a largo plazo, ofreciendo una alternativa ágil y rentable frente a mantener un departamento fijo y costoso internamente.',
          '<strong>Ventajas de la Flexibilidad:</strong>',
          { list: [
            '<strong>Costos Variables:</strong> Se paga por el servicio según se necesite, reduciendo gastos fijos en salarios, beneficios e infraestructura.',
            '<strong>Adaptabilidad:</strong> Facilita la expansión o reducción rápida de recursos según picos de demanda o cambios en el mercado.',
            '<strong>Acceso a Expertise:</strong> Permite contratar especialistas (estrategia, redes sociales, PR) sin largas contrataciones.',
            '<strong>Enfoque en el Negocio Principal:</strong> Libera recursos internos para que la empresa se concentre en sus competencias clave.',
          ] },
        ],
      },
      {
        question: '¿Qué tipo de empresas contratan este servicio?',
        answer: '',
        body: [
          { list: [
            '<strong>Grandes corporaciones</strong> que necesitan continuidad sin armar un equipo interno completo. Estas usan el outsourcing para funciones específicas, obteniendo tecnología, control de calidad y eficiencia.',
            '<strong>Pequeñas y Medianas Empresas (PYMES)</strong> que no tienen los recursos internos suficientes para armar un equipo interno de calidad. Es una opción muy inteligente para PYMES porque les permite ahorrar dinero y tiempo.',
            '<strong>Startups y Empresas en Crecimiento.</strong> que buscan optimizar recursos y convertir costos fijos en variables, externalizando funciones y así mantener el equilibrio financiero.',
          ] },
        ],
      },
    ]}
  />

  <ServiceFinalCTA titleHtml="Armemos tu <span class='hl'>equipo externo</span>" text="Solicitá una propuesta personalizada." />
</BaseLayout>

<style>
  :global(.hl) { color: var(--color-pink); }
  :global(.hl-purple) { color: var(--color-secondary); }
</style>
