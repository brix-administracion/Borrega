---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientHero from '../components/GradientHero.astro';
import { getImage } from 'astro:assets';
import { getWorkPosts, featuredImageOf, tileImageOf, postPath } from '../lib/wp';

// Listado completo de proyectos ("Nuestro trabajo") leido en vivo de WordPress.
const works = await getWorkPosts();

// Ancho de la miniatura: la tarjeta cuadrada mide como maximo ~335px (tres
// columnas justo antes del corte de 1100px; en otros anchos es menos). 640px
// cubre eso en retina sin pedir el original de WordPress.
const WORK_IMAGE_PX = 640;

// Una optimizacion por proyecto con getImage() y no con <Image>: el patron y la
// razon (descargas repetidas, inferSize prohibido) estan en DomeGallery.astro.
// Sin `fit`: sharp redimensiona por ancho y respeta el aspecto real; si WP no
// dio medidas se usa un aspecto de referencia en vez de inferSize.
const optimized = new Map<number, { src: string; width: number; height: number }>();
await Promise.all(
  works.map(async (post) => {
    const media = featuredImageOf(post);
    if (!media) return;
    const item = tileImageOf(media);
    const result = await getImage({
      src: item.src,
      width: WORK_IMAGE_PX,
      height: Math.round(((item.height ?? 2) / (item.width ?? 3)) * WORK_IMAGE_PX),
      format: 'webp',
      quality: 72,
    });
    optimized.set(post.id, {
      src: result.src,
      width: Number(result.attributes.width ?? WORK_IMAGE_PX),
      height: Number(result.attributes.height ?? WORK_IMAGE_PX),
    });
  }),
);
---

<BaseLayout title="Nuestro trabajo — Börrega Studio" description="Casos y proyectos de Börrega Studio.">
  <GradientHero>
    Nuestro trabajo
    <Fragment slot="subtitle">Casos y proyectos en los que trabajamos.</Fragment>
  </GradientHero>

  <section class="works">
    <div class="container">
      <ul class="works-grid">
        {works.map((post) => {
          const img = featuredImageOf(post);
          const thumb = optimized.get(post.id);
          const plainTitle = post.title.rendered.replace(/<[^>]+>/g, '');
          return (
            <li class="work-card" data-reveal>
              <a href={postPath(post)} class="work-link" aria-label={plainTitle}>
                {img && thumb && (
                  <img src={thumb.src} alt={img.alt_text || plainTitle} loading="lazy" width={thumb.width} height={thumb.height} />
                )}
                <span class="work-caption" set:html={post.title.rendered} />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .works { background: var(--color-bg); color: var(--color-white); padding-block: var(--space-5); }
  .works-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, 1fr);
  }
  .work-card { overflow: hidden; border-radius: 12px; aspect-ratio: 1 / 1; }
  .work-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-white);
  }
  .work-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease-out);
  }
  .work-card:hover .work-link img { transform: scale(1.06); }
  .work-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-3) var(--space-2) var(--space-2);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0));
  }

  @media (min-width: 700px) { .works-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .works-grid { grid-template-columns: repeat(4, 1fr); } }
</style>
